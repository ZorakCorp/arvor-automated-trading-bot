# ── Free default: Hyperliquid 5m fractal signals (no TradingView, no OpenAI) ──
SIGNAL_MODE=candles
LIVE_TRADING=false

# Optional fractal tuning
# FRACTAL_RISK_REWARD=2.0
# FRACTAL_REQUIRE_NESTED=false
# FRACTAL_HTF_INTERVAL=15m
# FRACTAL_CANDLE_LIMIT=200

# ── Paid / legacy modes (optional) ──
# SIGNAL_MODE=webhook
# TRADINGVIEW_WEBHOOK_SECRET=

# SIGNAL_MODE=screenshot
# OPENAI_API_KEY=
# TRADINGVIEW_CHART_URL=https://www.tradingview.com/chart/...

# Hyperliquid (required for LIVE_TRADING=true)
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_WALLET_ADDRESS=
ARVOR_CONFIRM_LIVE_RISK=false
HYPERLIQUID_TESTNET=false
AUTO_SPOT_TO_PERP=true
PAPER_STARTING_BALANCE=10000
LOG_LEVEL=INFO
