# Hyperliquid (required for LIVE_TRADING=true)
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_WALLET_ADDRESS=

# OpenAI vision
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# TradingView chart URL — ETH 5m with "Nested Fractal - Clean" indicator
TRADINGVIEW_CHART_URL=https://www.tradingview.com/chart/...

# Ms to wait for indicator lines/panel to render (default 18000)
SCREENSHOT_WAIT_MS=18000

# Safety: default is paper trading. Set true only when ready for real funds.
LIVE_TRADING=false

# Required when LIVE_TRADING=true (explicit risk acknowledgment)
ARVOR_CONFIRM_LIVE_RISK=false

# Use Hyperliquid testnet API (optional)
HYPERLIQUID_TESTNET=false

# Paper trading starting balance (USD)
PAPER_STARTING_BALANCE=10000

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
