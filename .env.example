# Required — live ETH chart + OpenAI (Nestal Fractal vision)
OPENAI_API_KEY=
CHART_URL=https://www.tradingview.com/chart/...
# Legacy alias: TRADINGVIEW_CHART_URL=

# Live trading ON by default (real Hyperliquid orders)
LIVE_TRADING=true
ARVOR_CONFIRM_LIVE_RISK=true
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_WALLET_ADDRESS=

OPENAI_MODEL=gpt-4o
SCREENSHOT_WAIT_MS=18000

# Optional: override full Nestal Fractal prompt (default in nestal_prompt.py)
# AI_PROMPT=

# Optional: Playwright saved login if chart is not public
# CHART_STORAGE_STATE_PATH=/app/data/chart_auth.json

# Paper mode only (no real orders): LIVE_TRADING=false

HYPERLIQUID_TESTNET=false
AUTO_SPOT_TO_PERP=true
LOG_LEVEL=INFO
