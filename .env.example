# Required
OPENAI_API_KEY=

# Chart for AI vision (recommended on Railway — no TradingView 403)
CHART_SOURCE=hyperliquid
# Or: CHART_SOURCE=auto (try CHART_URL, then Hyperliquid API fallback)
# CHART_URL=https://www.tradingview.com/chart/YOUR_REAL_ID/

# Live trading (default)
LIVE_TRADING=true
ARVOR_CONFIRM_LIVE_RISK=true
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_WALLET_ADDRESS=

OPENAI_MODEL=gpt-4o
SCREENSHOT_WAIT_MS=18000
LOG_LEVEL=INFO
HYPERLIQUID_TESTNET=false
AUTO_SPOT_TO_PERP=true

# Optional
# AI_PROMPT=
# CHART_STORAGE_STATE_PATH=/app/data/chart_auth.json

# Paper only: LIVE_TRADING=false
